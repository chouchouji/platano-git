{
  "name": "platano-git",
  "version": "0.5.2",
  "description": "A cli for simplifying git operations",
  "type": "module",
  "bin": {
    "platano": "dist/bin.js"
  },
  "scripts": {
    "dev": "rollup -c --watch",
    "build": "rimraf dist && rollup -c",
    "clean": "rimraf node_modules dist",
    "check": "biome check --write --verbose",
    "release": "pnpm build && vr release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chouchouji/platano-git.git"
  },
  "homepage": "https://github.com/chouchouji/platano-git",
  "keywords": [
    "cli",
    "nodejs",
    "git"
  ],
  "files": [
    "dist"
  ],
  "author": "chouchouji <1305974212@qq.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "simple-git-hooks": {
    "pre-commit": "pnpm exec nano-staged --allow-empty"
  },
  "nano-staged": {
    "*.js": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@inquirer/prompts": "^6.0.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "rattail": "1.0.13",
    "tinyexec": "^0.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^12.1.1",
    "@varlet/release": "^0.3.2",
    "nano-staged": "^0.8.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.22.0",
    "simple-git-hooks": "^2.11.1",
    "tslib": "^2.8.1",
    "typescript": "5.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "simple-git-hooks"
    ],
    "patchedDependencies": {
      "@inquirer/search@2.0.1": "patches/@inquirer__search@2.0.1.patch"
    }
  }
}
